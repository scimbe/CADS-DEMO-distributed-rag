# Copy this file to .env (gitignored) and fill in real values.
# rag/provider_pool.py reads these to route LLM calls; see its module docstring.

# --- Primary path: the team's local litellm-proxy ---
# Same convention as the other CADS-DEMO-* repos (codereview, diagram, travel, ...).
# If unset, provider_pool.py skips straight to the Groq fallback below (if configured).
LITELLM_BASE_URL=https://llm-34a13a96.bunsenbrenner.org/v1
LITELLM_API_KEY=sk-...
LITELLM_DEFAULT_MODEL=local-devstral-small2

# --- Fallback: Groq (free tier, no credit card) ---
# Only used when the local backend is rate-limited/unreachable. Never a hard
# dependency -- leave unset and the router simply won't fall back (a local
# outage surfaces as a normal error instead of silently reaching a third party).
# Get a free key (no credit card, no phone verification -- Google/GitHub/email
# signup) at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant   # default; override if you want a different free Groq model
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # default; no need to set unless it changes
